{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:question",
  "title": "Question (Q)",
  "description": "The root object of a research project. Not a discussion topic; it is the question the hypotheses attach to.",
  "allOf": [
    {
      "$ref": "urn:quaeralabs:v1:common#/$defs/base"
    }
  ],
  "required": [
    "title",
    "domain",
    "scope"
  ],
  "properties": {
    "id": {
      "pattern": "^Q-"
    },
    "type": {
      "const": "question"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1500,
      "description": "The research question. Up to 1500 characters for long statements such as competition problems (relaxed within v1: 300 → 1500)."
    },
    "domain": {
      "$ref": "urn:quaeralabs:v1:common#/$defs/domain"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Bounds of the question: which models, scales, theories"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "parentId": {
      "$ref": "urn:quaeralabs:v1:common#/$defs/publicId"
    }
  },
  "unevaluatedProperties": false
}
