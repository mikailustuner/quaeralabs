{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:skill",
  "title": "Skill",
  "description": "Reusable capability package. Tools are named by their MCP tool names. The community can write skills from v1.0; a skill declares its own permissions and the user approves them on first install.",
  "type": "object",
  "required": ["id", "version", "description", "tools", "requiredPermissions", "eval"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 10 },
    "domains": { "type": "array", "items": { "$ref": "urn:quaeralabs:v1:common#/$defs/domain" } },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "protocol"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "protocol": { "enum": ["mcp", "builtin"] },
          "server": { "type": "string", "description": "Name of the MCP server" }
        },
        "additionalProperties": false
      }
    },
    "requiredPermissions": {
      "description": "Permissions the agent needs for the skill to work. An agent cannot be given a skill that exceeds its permissions.",
      "type": "object",
      "properties": {
        "literatureRead": { "type": "boolean" },
        "codeWrite": { "enum": ["none", "analysis_scripts", "sandbox"] },
        "codeExecute": { "enum": ["none", "readonly_checks", "sandbox_no_gpu", "sandbox", "clean_sandbox"] },
        "gpuSpend": { "enum": ["none", "within_approved_plan"] }
      },
      "additionalProperties": false
    },
    "eval": { "type": "string", "description": "Path to the skill's own eval set, or 'pending'" }
  },
  "additionalProperties": false
}
