{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:bundle",
  "title": "Research bundle",
  "description": "An export carrying all objects of a research project. Each object is also validated against its own type's schema.",
  "type": "object",
  "required": ["schemaVersion", "title", "objects"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "title": { "type": "string" },
    "note": { "type": "string" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["question", "hypothesis", "preregistration", "experiment", "run", "result", "critique", "evidence_link", "verification", "artifact", "message"] }
        }
      }
    }
  },
  "additionalProperties": false
}
