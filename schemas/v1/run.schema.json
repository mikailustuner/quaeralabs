{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:run",
  "title": "Run (RUN)",
  "description": "A single run of an experiment. A pilot run comes before full runs; verification runs are done by the Verifier in a clean environment.",
  "allOf": [{ "$ref": "urn:quaeralabs:v1:common#/$defs/base" }],
  "required": ["experimentId", "kind", "status", "seed", "startedAt"],
  "properties": {
    "id": { "pattern": "^RUN-" },
    "type": { "const": "run" },
    "experimentId": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" },
    "kind": { "enum": ["pilot", "full", "verification"] },
    "status": { "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
    "seed": { "type": "integer" },
    "config": { "type": "object" },
    "hardware": { "type": "string" },
    "startedAt": { "$ref": "urn:quaeralabs:v1:common#/$defs/timestamp" },
    "endedAt": { "$ref": "urn:quaeralabs:v1:common#/$defs/timestamp" },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "logs": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" },
    "cost": { "$ref": "urn:quaeralabs:v1:common#/$defs/cost" }
  },
  "unevaluatedProperties": false
}
