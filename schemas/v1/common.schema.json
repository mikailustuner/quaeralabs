{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:common",
  "title": "QuaeraLabs common definitions",
  "description": "Id, actor, revision and approval definitions shared by all research objects.",
  "$defs": {
    "publicId": {
      "description": "Human-readable persistent id. The prefix gives the object type; the id stays the same even if the URL changes.",
      "type": "string",
      "pattern": "^(Q|H|PRE|E|RUN|RES|CR|EL|VER|ART|MSG)-[0-9]{4,}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "domain": { "enum": ["math", "ml"] },
    "role": {
      "enum": ["director", "literature", "hypothesis", "experiment_designer", "engineer", "analyst", "critic", "verifier", "writer", "manager"]
    },
    "actor": {
      "description": "Who produced an object or message. Agents require role and model; humans require a user id.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["agent", "human"] },
        "role": { "$ref": "#/$defs/role" },
        "model": { "type": "string", "minLength": 1, "description": "Provider/model id, e.g. anthropic/claude-opus-5-5" },
        "modelFamily": { "type": "string", "minLength": 1, "description": "Model family for the cross-model check, e.g. anthropic" },
        "userId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "agent" } } },
          "then": { "required": ["role", "model", "modelFamily"], "not": { "required": ["userId"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "human" } } },
          "then": { "required": ["userId"], "not": { "anyOf": [{ "required": ["role"] }, { "required": ["model"] }] } }
        }
      ]
    },
    "humanActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "kind": { "const": "human" } } }
      ]
    },
    "approval": {
      "description": "Record of a human approval. An approval always belongs to a human.",
      "type": "object",
      "required": ["by", "at", "decision"],
      "properties": {
        "by": { "$ref": "#/$defs/humanActor" },
        "at": { "$ref": "#/$defs/timestamp" },
        "decision": { "enum": ["approved", "rejected"] },
        "autonomyLevel": {
          "description": "The autonomy mode the approval was given in. In auto_under_limit mode the human approved the limit in advance.",
          "enum": ["manual", "auto_under_limit", "auto_to_budget_cap"]
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "tokensIn": { "type": "integer", "minimum": 0 },
        "tokensOut": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "gpuHours": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "base": {
      "description": "Fields every research object carries. A published revision cannot be modified; a change opens a new revision.",
      "type": "object",
      "required": ["id", "type", "revision", "createdAt", "createdBy"],
      "properties": {
        "id": { "$ref": "#/$defs/publicId" },
        "uuid": { "$ref": "#/$defs/uuid" },
        "type": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "createdBy": { "$ref": "#/$defs/actor" },
        "branchOf": {
          "description": "Branching: the source object and revision this object was forked from.",
          "type": "object",
          "required": ["id", "revision"],
          "properties": { "id": { "$ref": "#/$defs/publicId" }, "revision": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        }
      }
    }
  }
}
