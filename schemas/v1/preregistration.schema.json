{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:preregistration",
  "title": "Preregistration (PRE)",
  "description": "The analysis plan locked before the experiment runs. contentHash is the canonical JSON hash of the locked fields; every later change is appended as a change record and shows in the report.",
  "allOf": [{ "$ref": "urn:quaeralabs:v1:common#/$defs/base" }],
  "required": ["hypothesisId", "primaryMetric", "successCriterion", "analysisPlan", "lockedAt", "contentHash"],
  "properties": {
    "id": { "pattern": "^PRE-" },
    "type": { "const": "preregistration" },
    "hypothesisId": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" },
    "primaryMetric": { "type": "string", "minLength": 1 },
    "successCriterion": { "type": "string", "minLength": 5, "description": "Definition, written in advance, of the result that supports or refutes the hypothesis" },
    "analysisPlan": { "type": "string", "minLength": 10 },
    "seeds": { "type": "integer", "minimum": 1 },
    "lockedAt": { "$ref": "urn:quaeralabs:v1:common#/$defs/timestamp" },
    "contentHash": { "$ref": "urn:quaeralabs:v1:common#/$defs/sha256" },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "reason", "by", "change"],
        "properties": {
          "at": { "$ref": "urn:quaeralabs:v1:common#/$defs/timestamp" },
          "reason": { "type": "string", "minLength": 5 },
          "change": { "type": "string", "minLength": 3 },
          "by": { "$ref": "urn:quaeralabs:v1:common#/$defs/actor" },
          "afterResultsSeen": { "type": "boolean", "description": "Was the change made after the results were seen? If true, it is shown as a warning in the report." }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
