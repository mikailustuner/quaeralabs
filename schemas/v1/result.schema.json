{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:result",
  "title": "Result (RES)",
  "description": "The result the Analyst draws from the runs. In math, 'verified' can only be true when the Lean compiler output is attached.",
  "allOf": [
    { "$ref": "urn:quaeralabs:v1:common#/$defs/base" },
    {
      "if": { "properties": { "leanProof": { "properties": { "verified": { "const": true } }, "required": ["verified"] } }, "required": ["leanProof"] },
      "then": { "properties": { "leanProof": { "required": ["compilerOutput", "sorryFree"], "properties": { "sorryFree": { "const": true } } } } }
    }
  ],
  "required": ["experimentId", "runIds", "summary", "limitations"],
  "properties": {
    "id": { "pattern": "^RES-" },
    "type": { "const": "result" },
    "experimentId": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" },
    "runIds": { "type": "array", "minItems": 1, "items": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" } },
    "summary": { "type": "string", "minLength": 10 },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "negative": { "type": "boolean", "description": "A result that does not support the hypothesis; it goes into the report's 'What did not work?' section." },
    "leanProof": {
      "type": "object",
      "required": ["verified"],
      "properties": {
        "verified": { "type": "boolean" },
        "sorryFree": { "type": "boolean" },
        "compilerOutput": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId", "description": "Artifact id of the Lean compiler output" },
        "theoremName": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
