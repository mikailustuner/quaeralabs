{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaeralabs:v1:result",
  "title": "Sonuç (RES)",
  "description": "Analistin çalıştırmalardan çıkardığı sonuç. Matematikte 'verified' yalnızca Lean derleyici çıktısı ekliyse true olabilir.",
  "allOf": [
    { "$ref": "urn:quaeralabs:v1:common#/$defs/base" },
    {
      "if": { "properties": { "leanProof": { "properties": { "verified": { "const": true } }, "required": ["verified"] } }, "required": ["leanProof"] },
      "then": { "properties": { "leanProof": { "required": ["compilerOutput", "sorryFree"], "properties": { "sorryFree": { "const": true } } } } }
    }
  ],
  "required": ["experimentId", "runIds", "summary", "limitations"],
  "properties": {
    "id": { "pattern": "^RES-" },
    "type": { "const": "result" },
    "experimentId": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" },
    "runIds": { "type": "array", "minItems": 1, "items": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId" } },
    "summary": { "type": "string", "minLength": 10 },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "negative": { "type": "boolean", "description": "Hipotezi desteklemeyen sonuç; raporda 'Ne işe yaramadı?' bölümüne girer." },
    "leanProof": {
      "type": "object",
      "required": ["verified"],
      "properties": {
        "verified": { "type": "boolean" },
        "sorryFree": { "type": "boolean" },
        "compilerOutput": { "$ref": "urn:quaeralabs:v1:common#/$defs/publicId", "description": "Lean derleyici çıktısının artefakt kimliği" },
        "theoremName": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
